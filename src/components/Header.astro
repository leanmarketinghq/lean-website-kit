---
/**
 * A slim sticky bar: the logo on the left, then the links and the button, so
 * the call to action is one tap away from every screen of the page. From 640px
 * up the links sit in the bar. Below that phones get a Menu button that opens
 * the same links (the browser's own disclosure element, so it works without
 * JavaScript; the small script at the end only closes the menu again), and the
 * button shows in the bar only on a site with no links.
 *
 * The bar has a least height, not a fixed one, so a long name that wraps makes
 * the bar taller instead of spilling out of it. The page a visitor is on is
 * underlined in the links, not only darker, so it shows without relying on
 * colour.
 */
import Button from './Button.astro';
import Logo from './Logo.astro';
import { NAV } from '../data/site';

interface Props {
  /** The nav href to mark as the current page. */
  current?: string;
}
const { current } = Astro.props;
const isCurrent = (href: string) => (current === href ? 'page' : undefined);
/** No navigation (a one-page site): the logo on the left, the button on the right. */
const hasNav = NAV.length > 0;
const currentMark = 'aria-[current=page]:text-ink aria-[current=page]:underline aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-[0.4em]';
---

<header class="sticky top-0 z-30 border-b border-line/70 bg-paper/90 backdrop-blur-md">
  <div class="mx-auto flex min-h-14 max-w-6xl items-center gap-4 px-5 py-1.5 sm:min-h-16 sm:px-8">
    <div class="mr-auto">
      <Logo />
    </div>
    {hasNav && (
    <nav aria-label="Main">
      <ul class="hidden items-center gap-1 font-body text-[0.9375rem] sm:flex">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href)}
                class:list={['rounded-full px-3 py-1.5 text-muted transition-colors hover:bg-surface hover:text-ink', currentMark]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <details class="menu relative sm:hidden">
        <summary
          class="flex cursor-pointer list-none items-center gap-2 rounded-full border border-line px-3.5 py-1.5 font-body text-[0.9375rem] font-medium text-ink [&::-webkit-details-marker]:hidden"
        >
          Menu
          <svg aria-hidden="true" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
            <path d="M2 3.5h10M2 7h10M2 10.5h10"></path>
          </svg>
        </summary>
        <ul class="absolute right-0 z-40 mt-2 max-h-[calc(100dvh-5rem)] w-52 overflow-y-auto rounded-2xl border border-line bg-paper p-2 font-body text-[0.9375rem] shadow-lg">
          {
            NAV.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isCurrent(item.href)}
                  class:list={['flex items-center rounded-xl px-3 py-2 text-muted transition-colors hover:bg-surface hover:text-ink', currentMark]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
    </nav>
    )}
    <div class:list={[hasNav && 'hidden sm:block']}>
      <Button size="sm" />
    </div>
  </div>
</header>

<script is:inline>
  // The phone menu closes after a tap on one of its links, a tap anywhere
  // else, the Escape key, or when the keyboard moves on past it.
  for (const menu of document.querySelectorAll('details.menu')) {
    const close = () => menu.removeAttribute('open');
    menu.addEventListener('click', (event) => {
      if (event.target.closest('a')) close();
    });
    menu.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !menu.open) return;
      close();
      menu.querySelector('summary').focus();
    });
    menu.addEventListener('focusout', (event) => {
      if (event.relatedTarget && !menu.contains(event.relatedTarget)) close();
    });
    document.addEventListener('pointerdown', (event) => {
      if (menu.open && !menu.contains(event.target)) close();
    });
  }
</script>
