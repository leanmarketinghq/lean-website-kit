---
/** The track record in one row, under the hero's button: up to four short facts. */
import { PROOF } from '../data/home';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<aside class:list={['border-t border-line pt-8', className]} aria-label="Track record">
  <ul class="grid max-w-4xl grid-cols-2 gap-x-6 gap-y-6 md:grid-cols-4">
    {
      PROOF.map((fact) => (
        <li class="flex flex-col gap-1.5">
          <span class="heading-3 text-accent-ink">{fact.value}</span>
          <span class="font-body text-[0.875rem] leading-snug text-muted">{fact.label}</span>
        </li>
      ))
    }
  </ul>
</aside>
