---
/**
 * A call to action between sections: an optional line of words, the button,
 * and one reassurance line (the hero's note unless another is given). Place
 * it after any section where a reader may be ready.
 */
import Button from './Button.astro';
import { HERO } from '../data/home';

interface Props {
  heading?: string;
  note?: string;
  class?: string;
}
const { heading, note = HERO.note, class: className } = Astro.props;
---

<div class:list={['mx-auto max-w-6xl px-5 text-center sm:px-8', className]}>
  {heading && <p class="font-body text-[1.0625rem] sm:text-[1.25rem]">{heading}</p>}
  <div class:list={[heading && 'mt-5']}>
    <Button />
  </div>
  {note && <p class="mx-auto mt-3 max-w-md font-body text-[0.9375rem] leading-relaxed text-muted">{note}</p>}
</div>
