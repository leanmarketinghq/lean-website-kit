---
/**
 * Customer stories as cards: the result as the card's headline, the quote,
 * then the name and the role. Real customers and their own words only.
 */
interface Props {
  id: string;
  title: string;
  items: readonly { headline?: string; quote: string; name: string; role: string }[];
}
const { id, title, items } = Astro.props;
const columns = items.length >= 3 ? 'md:grid-cols-3' : 'md:grid-cols-2';
---

<section id={id} class="mx-auto max-w-6xl px-5 py-12 sm:px-8 sm:py-20">
  <h2 class="heading-2">{title}</h2>
  <div class:list={['mt-10 grid gap-6 md:gap-8', columns]}>
    {
      items.map((story) => (
        <figure class="flex flex-col rounded-2xl bg-surface px-6 py-6 sm:px-7">
          {story.headline && <h3 class="font-body text-[1.125rem] leading-snug font-bold">{story.headline}</h3>}
          <blockquote class="mt-3 font-body text-[1rem] leading-relaxed">{story.quote}</blockquote>
          <figcaption class="mt-auto pt-5">
            <span class="block border-t border-line pt-4 font-body text-sm font-bold tracking-wide uppercase">{story.name}</span>
            <span class="block font-body text-sm text-muted">{story.role}</span>
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>
