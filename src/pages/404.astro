---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
---

<Base title={`Page not found - ${SITE.name}`} description="This page doesn't exist, or it has moved." path="/404">
  <div class="mx-auto max-w-3xl px-5 pt-20 pb-8 sm:px-8 sm:pt-28">
    <p class="eyebrow">404</p>
    <h1 class="heading-2 mt-4">Page not found</h1>
    <p class="mt-6 font-body text-[1.25rem] leading-relaxed text-muted">That page doesn’t exist, or it has moved.</p>
    <div class="mt-10 flex flex-wrap gap-3">
      <a href="/" class="btn btn-primary">Go home</a>
    </div>
  </div>
</Base>
