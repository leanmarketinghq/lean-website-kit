---
/** Every markdown page in content/pages/ ("About.md" → /about). */
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
import { pages, type Page } from '../lib/pages';

export function getStaticPaths() {
  return pages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props as { page: Page };
const { Content } = page;
---

<Base title={`${page.title} - ${SITE.name}`} description={page.description} path={`/${page.slug}`} current={`/${page.slug}`}>
  <article class="mx-auto w-full max-w-[40rem] px-5 pt-12 sm:pt-20">
    <a href="/" class="back-link">← Home</a>
    <h1 class="heading-2 mt-6">{page.title}</h1>
    <div class="prose mt-8">
      <Content />
    </div>
  </article>
</Base>
