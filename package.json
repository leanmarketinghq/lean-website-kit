{
  "name": "lean-website-kit",
  "type": "module",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "brand": "node scripts/brand.mjs",
    "dev": "npm run brand && astro dev",
    "build": "npm run brand && astro build && npm test && node scripts/ready.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "check": "npm run build",
    "serve": "wrangler dev",
    "deploy": "npm run build && npx wrangler deploy"
  },
  "dependencies": {
    "astro": "7.4.13"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true,
    "fsevents": false
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@tailwindcss/vite": "4.3.5",
    "tailwindcss": "4.3.5",
    "wrangler": "4.164.0",
    "yaml": "2.9.1"
  }
}
